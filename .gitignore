# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
out/

.open-next
.wrangler
.dev.vars
worker-configuration.d.ts

# Tesla public key must be committed/deployed (overrides *.pem)
!public/.well-known/appspecific/com.tesla.3p.public-key.pem

# python
__pycache__/
*.pyc

# Personal finance data never belongs in this public repo. These catch the
# usual names: the finance page's backups (finance-backup-*.json), the
# imported profile and the analysis exports. Keep bank CSVs outside the repo.
finance-*.json
finance-*.csv
finance-*.md

# downloader agent runtime files, if it is ever run from the repo (config.json holds its key)
downloader/agent/config.json
downloader/agent/agent.log*
downloader/agent/work/
