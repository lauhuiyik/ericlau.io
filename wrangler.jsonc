{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ericlau-io",
  "main": ".open-next/worker.js",
  // Serve only via the ericlau.io custom domain. The *.workers.dev and
  // per-version preview URLs are NOT covered by Cloudflare Access, so they
  // would bypass the gate on /experiments/japan2026 — disable them.
  "workers_dev": false,
  "preview_urls": false,
  // Deploy target: the custom domain. Without this, disabling workers_dev
  // leaves wrangler with "No deploy targets" — it uploads a version but never
  // promotes it to the live domain.
  "routes": [{ "pattern": "ericlau.io", "custom_domain": true }],
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  // Home energy dashboard storage.
  "d1_databases": [
    { "binding": "DB", "database_name": "ericlau-energy", "database_id": "296f6f55-74f5-4809-ae12-e8b46a9f8636" },
    // /experiments/finance: the owner's vault, encrypted in the browser (ciphertext only).
    {
      "binding": "FINANCE_DB",
      "database_name": "ericlau-finance",
      "database_id": "970949ea-7c0c-434c-a111-e5db27087f30",
      "migrations_dir": "finance/migrations"
    },
    // /tools/downloader: the job queue the home-PC agent works through.
    {
      "binding": "DL_DB",
      "database_name": "ericlau-downloader",
      "database_id": "59bf1486-e457-4a90-9ba7-adb1e1b3b23e",
      "migrations_dir": "downloader/migrations"
    }
  ],
  // /tools/downloader: finished files, uploaded by the home-PC agent and
  // deleted after 24 hours (by the app, with a bucket lifecycle rule as backstop).
  "r2_buckets": [
    { "binding": "DL_BUCKET", "bucket_name": "ericlau-downloads" },
    // The self-hosted media bucket (media.ericlau.io). The Worker only writes
    // the doorbell files under status/ (src/lib/doorbell.ts) that the home PC
    // and the energy cron Worker read, so they don't have to poll this Worker.
    { "binding": "MEDIA_BUCKET", "bucket_name": "ericlau-media" },
    // Password-gated pages (src/lib/private-pages.ts). No public domain: the
    // only way in is the Worker, after the page's password.
    { "binding": "PRIVATE_BUCKET", "bucket_name": "ericlau-private" }
  ],
  // Turning energy Live mode on asks the cron Worker for a reading right away,
  // instead of waiting for its next 5-minute tick.
  "services": [
    { "binding": "ENERGY_PINGER", "service": "ericlau-energy-cron-pinger" }
  ],
  "kv_namespaces": [
    { "binding": "ENERGY_KV", "id": "fce2b129d1ed462c853380cb027bca32" }
  ],
  // The Cloudflare Access application covering /experiments/finance (shared
  // with /experiments/homeenergy; it does NOT cover all of /experiments/*).
  // Pages that call checkAccess() (src/lib/cf-access.ts) verify the Access
  // token against these.
  // Identifiers, not secrets: only Cloudflare's private key can sign a token
  // they accept. Kept here, not in the dashboard, so every deploy carries them.
  "vars": {
    "CF_ACCESS_TEAM_DOMAIN": "ericdotlau.cloudflareaccess.com",
    "CF_ACCESS_AUD": "53e8f5be2189a70e6c3b390fd5bf69ef40c21eaec613c55413899cb3b8b8b0f5"
  },
  "observability": {
    "enabled": true
  }
}
